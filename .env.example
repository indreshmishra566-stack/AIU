# ═══════════════════════════════════════════════════════════════════════════════
#  AIU — Environment Variables Template
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Django ─────────────────────────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-generate-with-command-above

# Generate same way (different value from SECRET_KEY)
JWT_SIGNING_KEY=change-me-generate-with-command-above

# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me-generate-with-fernet-command-above

DJANGO_DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ───────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=choose-a-strong-database-password
DATABASE_URL=postgresql://aiu_user:${POSTGRES_PASSWORD}@postgres:5432/aiu_db

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=choose-a-strong-redis-password
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/1
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/2

# ── AI Provider — GROQ (FREE) ─────────────────────────────────────────────────
# Get your FREE key at: https://console.groq.com (no credit card needed)
LLM_PROVIDER=groq
LLM_MODEL=llama3-70b-8192
LLM_EMBEDDING_MODEL=local

GROQ_API_KEY=gsk_...   # your free Groq key

# Available FREE models on Groq:
#   llama3-70b-8192     (best quality, recommended)
#   llama3-8b-8192      (faster, lighter)
#   mixtral-8x7b-32768  (good for long context)
#   gemma2-9b-it        (Google Gemma 2)

# ── Frontend ───────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000

# Optional local host-port overrides when Docker ports conflict with services on
# your machine. These are ignored in Docker and used only for host-side runs.
LOCAL_POSTGRES_PORT=5433
LOCAL_REDIS_PORT=6380

# ── Security ───────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_ANON=100/hour
RATE_LIMIT_USER=1000/hour
RATE_LIMIT_AI=60/hour

# ── Monitoring (optional) ──────────────────────────────────────────────────────
SENTRY_DSN=
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# ── For Docker Compose (local dev) ────────────────────────────────────────────
GRAFANA_PASSWORD=admin
DOMAIN=localhost
