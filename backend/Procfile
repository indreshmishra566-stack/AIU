web: gunicorn --worker-class uvicorn.workers.UvicornWorker --workers 2 --bind 0.0.0.0:$PORT --timeout 120 --log-level info config.asgi:application
worker: celery -A config.celery worker --loglevel=info --concurrency=2 --queues=embeddings,ai_processing,analytics,celery --max-tasks-per-child=100
beat: celery -A config.celery beat --loglevel=info --scheduler django_celery_beat.schedulers:DatabaseScheduler
release: python manage.py migrate --noinput
